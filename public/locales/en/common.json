  "faq": {
    "title": "FAQ",
    "subtitle": "Frequently asked questions about Ludify.",
    "back": "Back",
    "stillHaveQuestions": "Still have questions?",
    "q1": "What is Ludify?",
    "a1": "Ludify is a social network for board game enthusiasts. Discover game nights near you, connect with local players, manage your collection, and buy or sell games with people in your community.",
    "q2": "How do I join a game night?",
    "a2": "Browse the Tables tab to find public game nights near you. Tap any table to see details, then hit \"Join Game\" to reserve your spot. The host will be notified and can confirm your attendance.",
    "q3": "Is Ludify free to use?",
    "a3": "Yes — creating an account, joining tables, and browsing the marketplace are completely free.",
    "q4": "How does the marketplace work?",
    "a4": "List any board game from your collection for sale. Buyers can browse listings and contact you to arrange payment and pickup. Ludify does not process payments — transactions happen directly between users.",
    "q5": "Where does game data come from?",
    "a5": "Game information (names, descriptions, artwork, ratings) is provided by BoardGameGeek via their XML API. Ludify is powered by BoardGameGeek.",
    "q6": "How do I contact Ludify?",
    "a6": "Reach us at hello@ludify.app or on Instagram @ludify.app."
  },
